---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title?: string
  description?: string
  /** Set on article pages so the meta type and canonical are right */
  canonical?: string
}

const SITE_NAME = 'Andrew Ritter'
const DEFAULT_DESC = 'Andrew Ritter — product development and engineering. Writing on building software with AI at the gate.'

const { title, description = DEFAULT_DESC, canonical } = Astro.props
const pageTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — Product development & engineering`
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#070808" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={canonical ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=JetBrains+Mono:wght@300;400;500&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Vercel Web Analytics (enable it in the Vercel dashboard → Analytics) -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
