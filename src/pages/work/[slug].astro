---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { publishedWork } from '../../lib'

export async function getStaticPaths() {
  const work = await publishedWork()
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

// The study documents that belong to this project, in declared order.
const studies = (await getCollection('studies', ({ id }) => id.startsWith(entry.id + '/')))
  .sort((a, b) => a.data.order - b.data.order)
const rendered = await Promise.all(studies.map(async (s) => ({ ...s, Content: (await render(s)).Content })))
const anchor = (id: string) => id.split('/').pop()

const { title, tagline, role, period, status, stack, links, version, updated } = entry.data
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base title={title} description={tagline}>
  <article class="section">
    <div class="wrap">
      <p class="mono" style="margin-bottom: 1.5rem"><a class="link" href="/work">Work</a></p>
      <h1 style="margin-bottom: 1rem">{title}</h1>
      <p class="lede" style="margin-bottom: 2.5rem">{tagline}</p>

      <dl class="facts">
        <div><dt class="mono">Role</dt><dd>{role}</dd></div>
        <div><dt class="mono">Period</dt><dd>{period}</dd></div>
        <div><dt class="mono">Status</dt><dd>{status}</dd></div>
        {version && <div><dt class="mono">Study</dt><dd>v{version}{updated && ` · ${fmt(updated)}`}</dd></div>}
        {links.length > 0 && (
          <div><dt class="mono">Links</dt><dd>{links.map((l, i) => <><a class="link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>{i < links.length - 1 ? ' · ' : ''}</>)}</dd></div>
        )}
      </dl>
      {stack.length > 0 && <div class="tags" style="margin-bottom: 3rem">{stack.map((s) => <span class="tag">{s}</span>)}</div>}

      {rendered.length > 0 && (
        <nav class="toc" aria-label="Study contents">
          <span class="mono">In this study</span>
          {rendered.map((s) => <a class="link" href={`#${anchor(s.id)}`}>{s.data.title}</a>)}
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {rendered.map((s) => (
        <section id={anchor(s.id)} class="study">
          <h2>{s.data.title}</h2>
          <div class="prose"><s.Content /></div>
        </section>
      ))}
    </div>
  </article>
</Base>

<style>
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem; }
  .facts dt { margin-bottom: 0.3rem; }
  .facts dd { color: var(--fg); }
  .toc { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: baseline; padding: 1rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 3rem; }
  .study { margin-top: 5rem; padding-top: 3rem; border-top: 1px solid var(--border); }
  .study h2 { margin-bottom: 1.5rem; }
</style>
