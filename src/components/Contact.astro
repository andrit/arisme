---
import ContactForm from '../islands/ContactForm'
const links = [
  { label: 'GitHub',   href: 'https://github.com/andrit' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/andrewritterdeveloper' },
]
---
<section id="contact" class="section">
  <div class="wrap">
    <div class="section-label">Contact</div>
    <h2 class="contact-title">Let's build something<em class="accent">.</em></h2>
    <div class="grid-2">
      <div>
        <p class="lede">
          Whether you have a project in mind, want to explore a wild idea together,
          or just want to swap hiking trail recommendations — I'm all ears.
        </p>
        <p style="margin-top: 1.5rem">
          <a class="link link-arrow" href="mailto:andy@andrewritter.me">andy@andrewritter.me</a>
        </p>
        <p class="mono" style="margin-top: 2.5rem; margin-bottom: 0.75rem">Elsewhere</p>
        <p>
          {links.map((l, i) => (
            <>
              <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>{i < links.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </div>
      <ContactForm client:visible />
    </div>
  </div>
</section>

<style>
  .contact-title { font-size: clamp(2.6rem, 6vw, 5rem); margin-bottom: 3rem; }
</style>
